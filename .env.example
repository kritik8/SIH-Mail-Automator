# SMTP Configuration
# Default is smtp.gmail.com for institutional or personal Gmail accounts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@iiitbhopal.ac.in
SMTP_PASSWORD=your-app-password

# Dry Run Configuration
# If true, emails will not be sent to real recipients. Instead, they will be saved
# to the preview/ directory, or sent only to the TEST_RECIPIENT.
DRY_RUN=true
TEST_RECIPIENT=your-test-email@example.com
