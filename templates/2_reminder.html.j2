<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIH Internal Hackathon - Nudge / Reminder</title>
</head>
<body style="margin: 0; padding: 0; background-color: #ffffff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #333333; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; line-height: 1.6;">

  <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #ffffff; padding: 40px 0;">
    <tr>
      <td align="center">
        <!-- Main Container -->
        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; background-color: #ffffff; border: 1px solid #eeeeee; border-radius: 4px;">
          
          <!-- Navy Header Bar -->
          <tr>
            <td style="background-color: #1e3a8a; padding: 20px 24px; text-align: center;">
              <h1 style="margin: 0; color: #ffffff; font-size: 18px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;">
                SIH Internal Hackathon &bull; Tomorrow
              </h1>
            </td>
          </tr>

          <!-- Content Body -->
          <tr>
            <td style="padding: 32px 32px 40px 32px;">
              <!-- Greeting -->
              <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #333333;">
                Dear {{ leader_name }},
              </p>
              
              <p style="margin: 0 0 24px 0; font-size: 15px; color: #333333;">
                This is a quick final reminder that the Internal SIH Selection Round begins tomorrow. 
                Your team, <strong>{{ team_name }}</strong> (Team Number: <strong>{{ team_number }}</strong>), is scheduled to participate at:
              </p>

              <!-- Event Details Nudge -->
              <table border="0" cellpadding="12" cellspacing="0" width="100%" style="background-color: #fafafa; border: 1px solid #eeeeee; border-radius: 4px; margin-bottom: 24px;">
                <tr>
                  <td>
                    <table border="0" cellpadding="0" cellspacing="0" width="100%">
                      <tr style="vertical-align: top;">
                        <td width="20%" style="padding: 4px 0; font-size: 14px; font-weight: 600; color: #1e3a8a;">Date/Time:</td>
                        <td style="padding: 4px 0; font-size: 14px; font-weight: bold; color: #333333;">{{ event_date }}</td>
                      </tr>
                      <tr style="vertical-align: top;">
                        <td width="20%" style="padding: 4px 0; font-size: 14px; font-weight: 600; color: #1e3a8a;">Venue:</td>
                        <td style="padding: 4px 0; font-size: 14px; color: #333333;">{{ event_venue }}</td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Quick Checklist Bullets -->
              <h2 style="margin: 0 0 12px 0; font-size: 14px; font-weight: 600; color: #1e3a8a; text-transform: uppercase; letter-spacing: 0.05em;">
                Quick Checklist
              </h2>
              <ul style="margin: 0 0 28px 0; padding-left: 20px; font-size: 14px; color: #333333;">
                <li style="margin-bottom: 8px;">Arrive at the NTB registration desk by 8:30 AM.</li>
                <li style="margin-bottom: 8px;">Bring your college student ID cards (mandatory for entry).</li>
                <li style="margin-bottom: 8px;">Bring your laptops, power strips, and required chargers.</li>
                <li style="margin-bottom: 8px;">Ensure all development tools and IDEs are installed and configured.</li>
              </ul>
              
              <p style="margin: 0 0 24px 0; font-size: 15px; font-weight: 600; color: #1e3a8a;">
                Best of luck, Team {{ team_name }}! Show us your best innovation.
              </p>

              <!-- SPOC Info -->
              <p style="margin: 0; font-size: 14px; color: #333333; border-top: 1px solid #eeeeee; padding-top: 24px;">
                For any immediate coordination issues, contact the institutional SPOC:
                <br>
                <strong>{{ spoc_name }}</strong> ({{ spoc_role }})
                <br>
                Email: <a href="mailto:{{ spoc_email }}" style="color: #1e3a8a; text-decoration: none; font-weight: 600;">{{ spoc_email }}</a>
              </p>
            </td>
          </tr>

          <!-- Footer Area -->
          <tr>
            <td style="background-color: #fafafa; border-top: 1px solid #eeeeee; padding: 24px; text-align: center; font-size: 11px; color: #777777;">
              <p style="margin: 0;">
                &copy; 2026 Indian Institute of Information Technology, Bhopal. All rights reserved.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

</body>
</html>
