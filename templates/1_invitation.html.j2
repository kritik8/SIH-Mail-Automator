<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart India Hackathon 2026 - Internal Selection Round</title>
  <style>
    @media only screen and (max-width: 600px) {
      .main-container {
        padding: 20px 16px !important;
      }
      .content-card {
        padding: 24px 20px !important;
      }
      .meta-table td {
        display: block !important;
        width: 100% !important;
        box-sizing: border-box !important;
      }
      .meta-label {
        padding-bottom: 2px !important;
      }
      .meta-value {
        padding-bottom: 12px !important;
      }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; color: #1e293b; line-height: 1.6; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;">

  <table border="0" cellpadding="0" cellspacing="0" width="100%" class="main-container" style="background-color: #f8fafc; padding: 40px 0;">
    <tr>
      <td align="center">
        <!-- Main Card Container -->
        <table border="0" cellpadding="0" cellspacing="0" width="100%" class="content-card" style="max-width: 600px; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.025); overflow: hidden;">
          
          <!-- Top Gradient Accent Bar -->
          <tr>
            <td style="background: linear-gradient(135deg, #4f46e5 0%, #2563eb 100%); height: 6px; font-size: 0; line-height: 0;">&nbsp;</td>
          </tr>

          <!-- Content Body -->
          <tr>
            <td style="padding: 40px 32px;">
              <!-- Logo / Event Subtitle -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 28px;">
                <tr>
                  <td>
                    <span style="font-size: 11px; font-weight: 700; color: #4f46e5; text-transform: uppercase; letter-spacing: 0.15em; display: block; margin-bottom: 4px;">Institutional Selection Round</span>
                    <h1 style="margin: 0; font-size: 22px; font-weight: 800; color: #0f172a; letter-spacing: -0.02em;">Smart India Hackathon 2026</h1>
                  </td>
                </tr>
              </table>

              <!-- Greeting -->
              <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
                Dear {{ leader_name }},
              </p>
              
              <p style="margin: 0 0 32px 0; font-size: 15px; color: #475569; line-height: 1.7;">
                Congratulations! Your team has been shortlisted for the <strong>Internal Selection Round</strong> of Smart India Hackathon (SIH) 2026 at IIIT Bhopal. Below are your assigned team details, your allocated mentor, and the selection round schedule.
              </p>

              <!-- Section 1: Team & Mentor Details -->
              <h2 style="margin: 0 0 14px 0; font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.1em;">
                Roster & Assignment
              </h2>
              
              <table border="0" cellpadding="0" cellspacing="0" width="100%" class="meta-table" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 32px; padding: 20px;">
                <tr style="vertical-align: top;">
                  <td width="35%" class="meta-label" style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #64748b;">Team ID:</td>
                  <td class="meta-value" style="padding: 6px 0; font-size: 14px; font-weight: 700; color: #0f172a;">{{ team_number }}</td>
                </tr>
                <tr style="vertical-align: top;">
                  <td class="meta-label" style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #64748b;">Team Name:</td>
                  <td class="meta-value" style="padding: 6px 0; font-size: 14px; color: #334155; font-weight: 500;">{{ team_name }}</td>
                </tr>
                {% if track %}
                <tr style="vertical-align: top;">
                  <td class="meta-label" style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #64748b;">Category of PS:</td>
                  <td class="meta-value" style="padding: 6px 0; font-size: 14px; color: #334155; font-weight: 500;">{{ track }}</td>
                </tr>
                {% endif %}
                {% if mentor_allocated %}
                <tr style="vertical-align: top;">
                  <td class="meta-label" style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #64748b;">Allocated Mentor:</td>
                  <td class="meta-value" style="padding: 6px 0; font-size: 14px; color: #4f46e5; font-weight: 700;">{{ mentor_allocated }}</td>
                </tr>
                {% endif %}
              </table>

              <!-- Section 2: Team Members Table -->
              <h2 style="margin: 0 0 14px 0; font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.1em;">
                Registered Team Members
              </h2>
              <div style="border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; margin-bottom: 32px;">
                <table border="0" cellpadding="10" cellspacing="0" width="100%" style="font-size: 13px; border-collapse: collapse; background-color: #ffffff;">
                  <thead>
                    <tr style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; text-align: left; color: #64748b; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;">
                      <th style="padding: 12px 16px;">Name</th>
                      <th style="padding: 12px 16px;">Scholar No.</th>
                      <th style="padding: 12px 16px; text-align: center;">Gender</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                      <td style="padding: 12px 16px; font-weight: 600; color: #0f172a;">{{ leader.name }} <span style="font-size: 10px; background-color: #e0e7ff; color: #4338ca; padding: 2px 6px; border-radius: 4px; font-weight: 500; margin-left: 4px;">Leader</span></td>
                      <td style="padding: 12px 16px; color: #475569;">{{ leader.scholar_id }}</td>
                      <td style="padding: 12px 16px; color: #475569; text-align: center;"><span style="background-color: #f1f5f9; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 500;">{{ leader.gender }}</span></td>
                    </tr>
                    {% for m in members %}
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                      <td style="padding: 12px 16px; color: #334155;">{{ m.name }}</td>
                      <td style="padding: 12px 16px; color: #475569;">{{ m.scholar_id }}</td>
                      <td style="padding: 12px 16px; color: #475569; text-align: center;"><span style="background-color: #f1f5f9; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 500;">{{ m.gender }}</span></td>
                    </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>

              <!-- Section 3: Event Schedule Card -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; margin-bottom: 32px; padding: 20px;">
                <tr>
                  <td>
                    <table border="0" cellpadding="0" cellspacing="0" width="100%">
                      <tr style="vertical-align: top;">
                        <td>
                          <h3 style="margin: 0 0 6px 0; font-size: 14px; font-weight: 700; color: #1e40af;">Hackathon Schedule</h3>
                          <p style="margin: 0; font-size: 13px; color: #1e3a8a; line-height: 1.5;">
                            <strong>Date:</strong> {{ event_date }}
                            <br>
                            <strong>Venue:</strong> {{ event_venue }}
                          </p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Section 4: Guidelines -->
              <h2 style="margin: 0 0 14px 0; font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.1em;">
                Participant Guidelines
              </h2>
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="font-size: 14px; color: #475569; margin-bottom: 32px; line-height: 1.6;">
                <tr>
                  <td width="4%" style="vertical-align: top; padding-bottom: 10px; color: #4f46e5; font-weight: bold;">1.</td>
                  <td style="padding-bottom: 10px; padding-left: 8px;">Each team must consist of exactly 6 members from the same institution.</td>
                </tr>
                <tr>
                  <td style="vertical-align: top; padding-bottom: 10px; color: #4f46e5; font-weight: bold;">2.</td>
                  <td style="padding-bottom: 10px; padding-left: 8px;">At least one female member is mandatory in every team.</td>
                </tr>
                <tr>
                  <td style="vertical-align: top; padding-bottom: 10px; color: #4f46e5; font-weight: bold;">3.</td>
                  <td style="padding-bottom: 10px; padding-left: 8px;">Registrations are processed solely via College SPOC nomination on the national portal.</td>
                </tr>
                <tr>
                  <td style="vertical-align: top; padding-bottom: 10px; color: #4f46e5; font-weight: bold;">4.</td>
                  <td style="padding-bottom: 10px; padding-left: 8px;">The final selection round will evaluate problem category fits and idea feasibility.</td>
                </tr>
              </table>

              <!-- SPOC Contact Info -->
              <div style="border-top: 1px solid #f1f5f9; padding-top: 24px; font-size: 13px; color: #64748b; line-height: 1.6;">
                For any immediate queries or coordination, please contact the institutional SPOC:
                <div style="margin-top: 8px; color: #334155; font-weight: 500;">
                  <strong style="color: #0f172a;">{{ spoc_name }}</strong>
                  <br>
                  {{ spoc_role }}
                  <br>
                  Email: <a href="mailto:{{ spoc_email }}" style="color: #4f46e5; text-decoration: none; font-weight: 600;">{{ spoc_email }}</a>
                </div>
              </div>

            </td>
          </tr>

          <!-- Footer Area -->
          <tr>
            <td style="background-color: #f8fafc; border-top: 1px solid #e2e8f0; padding: 24px 32px; text-align: center; font-size: 11px; color: #94a3b8; line-height: 1.5;">
              <p style="margin: 0 0 6px 0;">
                This email was sent to notify you regarding the Smart India Hackathon 2026 internal processes.
              </p>
              <p style="margin: 0; font-weight: 500; color: #64748b;">
                &copy; 2026 Indian Institute of Information Technology, Bhopal. All rights reserved.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

</body>
</html>
